{
  "name": "gecko-forge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "npm run art:check && vitest run",
    "test:e2e": "playwright test",
    "test:integration": "npm run test:baseline",
    "test:baseline": "vitest run tests/baseline.test.ts",
    "art:check": "node scripts/compile-gecko-art.mjs --check",
    "art:compile": "node scripts/compile-gecko-art.mjs",
    "pack:project": "node scripts/pack-project.mjs",
    "build": "npm run typecheck && vite build",
    "build:engine": "vite build --mode engine",
    "preview": "vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
